<UserControl x:Class="PortCheck.Controls.ExcludedPortRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Style="{StaticResource GlassCompactRowGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Glass.Align.IconColumn}"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{StaticResource Glass.Align.ShortcutColumn}"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="22"
                Height="22"
                CornerRadius="7"
                Background="{StaticResource Settings.BlueIconFill}"
                BorderBrush="#52FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock Text="&#xE8B7;"
                       FontFamily="Segoe Fluent Icons"
                       Foreground="White"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding Port, ElementName=Root, StringFormat=':{0}'}"
                   Style="{StaticResource GlassTextPrimaryShadow}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding RemoveCommand, ElementName=Root}"
                CommandParameter="{Binding Port, ElementName=Root}"
                Style="{StaticResource GlassRowKillIconButton}"/>
    </Grid>
</UserControl>
