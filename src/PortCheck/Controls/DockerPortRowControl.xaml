<UserControl x:Class="PortCheck.Controls.DockerPortRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="FavouriteStarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{StaticResource Glass.Metrics.KillButton}"/>
            <Setter Property="Height" Value="{StaticResource Glass.Metrics.KillButton}"/>
            <Setter Property="Background" Value="{StaticResource Glass.Action.Ghost.Fill}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="999"/>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE734;"/>
                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                                <Setter Property="Text" Value="&#xE735;"/>
                                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass.Action.Ghost.HoverFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding IsConfirmingKill}" Value="False"/>
                        <Condition Binding="{Binding IsKilling}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="NormalRow" Style="{StaticResource GlassCompactRowGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Glass.Align.IconColumn}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource Glass.Align.ShortcutColumn}"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"
                  Width="20"
                  Height="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Ellipse Width="6"
                         Height="6"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF6B7280"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHostListening}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Status.Active}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Button Command="{Binding ElementName=Root, Path=ToggleFavouriteCommand}"
                        CommandParameter="{Binding HostPort}"
                        ToolTip="Toggle favourite port"
                        Style="{StaticResource FavouriteStarButtonStyle}"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayHostPort}"
                               Style="{StaticResource GlassTextPrimaryShadow}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource Text.Primary}"/>
                    <TextBlock Text="{Binding HostAddress}"
                               Style="{StaticResource GlassTextTertiaryShadow}"
                               FontSize="10"
                               Margin="6,0,0,0"
                               Foreground="{StaticResource Text.Tertiary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding DisplayPortDetail}"
                           Style="{StaticResource GlassTextSecondaryShadow}"
                           FontSize="11"
                           Foreground="{StaticResource Text.Secondary}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="ProcessingText"
                       Grid.Column="2"
                       Text="..."
                       FontSize="13"
                       Foreground="#F4AB3A"
                       Visibility="Collapsed"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            <Button x:Name="KillButton"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ToolTip="Stop container"
                    Click="BeginKill_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GlassRowKillIconButton}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                    <Condition Binding="{Binding IsConfirmingKill}" Value="False"/>
                                    <Condition Binding="{Binding IsKilling}" Value="False"/>
                                    <Condition Binding="{Binding IsKillSupported}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid x:Name="ConfirmRow"
              Visibility="Collapsed"
              MinHeight="{StaticResource Glass.Metrics.RowMinHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource GlassTextPrimaryShadow}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource Text.Primary}">
                <Run Text="Kill "/>
                <Run Text="{Binding ContainerName}"/>
                <Run Text="?"/>
            </TextBlock>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0">
                <Button Content="Kill"
                        Style="{StaticResource GlassRowKillButton}"
                        Click="ConfirmKill_Click"/>
                <Button Content="X"
                        Style="{StaticResource GlassRowDismissButton}"
                        Click="CancelKill_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
