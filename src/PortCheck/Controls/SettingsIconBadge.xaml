<UserControl x:Class="PortCheck.Controls.SettingsIconBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="22"
             Height="22"
             VerticalAlignment="Center">
    <Border Width="22"
            Height="22"
            CornerRadius="7"
            Background="{Binding IconBackground, ElementName=Root}"
            BorderBrush="#52FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <TextBlock Text="{Binding IconGlyph, ElementName=Root}"
                   FontFamily="Segoe Fluent Icons"
                   FontSize="12"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
