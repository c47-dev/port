<UserControl x:Class="PortCheck.Controls.LocalPortRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid x:Name="NormalRow" Style="{StaticResource GlassActionRowGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Glass.Align.IconColumn}"/>
                <ColumnDefinition Width="{StaticResource Glass.Align.PortColumn}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource Glass.Align.ShortcutColumn}"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"
                  Width="20"
                  Height="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Ellipse x:Name="ActiveDot"
                         Width="6"
                         Height="6"
                         Fill="{StaticResource Status.Active}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                <ContentControl x:Name="DockerLeadingIcon"
                                ContentTemplate="{StaticResource DockerPortLeadingIcon}"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Column="1"
                       Text="{Binding DisplayPort}"
                       Style="{StaticResource GlassTextPrimaryShadow}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Foreground="{StaticResource Text.Primary}"
                       VerticalAlignment="Center"
                       Margin="6,0,4,0"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding ProcessName}"
                       Style="{StaticResource GlassTextSecondaryShadow}"
                       FontSize="12"
                       Foreground="{StaticResource Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="PidText"
                       Grid.Column="3"
                       Text="{Binding Pid}"
                       FontSize="10"
                       Foreground="{StaticResource Text.Tertiary}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource GlassTextTertiaryShadow}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                    <Condition Binding="{Binding IsConfirmingKill}" Value="False"/>
                                    <Condition Binding="{Binding IsKilling}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsConfirmingKill}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKilling}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="ProcessingText"
                       Grid.Column="3"
                       Text="..."
                       FontSize="13"
                       Foreground="#F4AB3A"
                       Visibility="Collapsed"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            <Button x:Name="KillButton"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ToolTip="Kill process on this port"
                    Click="BeginKill_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GlassRowKillIconButton}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                    <Condition Binding="{Binding IsConfirmingKill}" Value="False"/>
                                    <Condition Binding="{Binding IsKilling}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid x:Name="ConfirmRow"
              Visibility="Collapsed"
              MinHeight="{StaticResource Glass.Metrics.RowMinHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource GlassTextPrimaryShadow}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource Text.Primary}">
                <Run Text="Kill "/>
                <Run Text="{Binding ProcessName}"/>
                <Run Text="?"/>
            </TextBlock>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0">
                <Button Content="Kill"
                        Style="{StaticResource GlassRowKillButton}"
                        Click="ConfirmKill_Click"/>
                <Button Content="X"
                        Style="{StaticResource GlassRowDismissButton}"
                        Click="CancelKill_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
