<Window x:Class="PortCheck.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PortCheck.Models"
        xmlns:controls="clr-namespace:PortCheck.Controls"
        Title="PortCheck"
        Width="340"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated">

    <Border x:Name="OuterChromeBorder" CornerRadius="20" ClipToBounds="True" Effect="{StaticResource Glass.WindowShadow}">
        <Grid x:Name="OuterGlassRoot">
            <Image x:Name="BackdropImage" Stretch="Fill" IsHitTestVisible="False"/>
            <Border CornerRadius="20" Background="{StaticResource Glass.Tint}" IsHitTestVisible="False"/>
            <Border CornerRadius="20" Background="{StaticResource Glass.InnerSheen}" IsHitTestVisible="False"/>
            <Border CornerRadius="20"
                    BorderBrush="{StaticResource Glass.RimLight}"
                    BorderThickness="1"
                    Background="Transparent"
                    IsHitTestVisible="False"/>

            <Border x:Name="InnerChromeBorder" CornerRadius="18" Margin="2" Background="Transparent">
                <Grid x:Name="InnerContentRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,16,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Search.Fill}"
                                CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"
                                BorderBrush="{StaticResource Search.Stroke}"
                                BorderThickness="1"
                                Height="{StaticResource Glass.Metrics.ChromeRowHeight}"
                                Margin="0,0,8,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           FontFamily="Segoe Fluent Icons"
                                           Style="{StaticResource GlassTextSecondaryShadow}"
                                           Margin="10,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="12"/>
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource Text.Primary}"
                                         CaretBrush="{StaticResource Text.Primary}"
                                         VerticalContentAlignment="Center"
                                         FontSize="12"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Grid.Column="1"
                                           Text="Search local ports…"
                                           IsHitTestVisible="False"
                                           Foreground="{StaticResource Text.Secondary}"
                                           Effect="{StaticResource Text.Shadow}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,10,0"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Button x:Name="SortFilterButton"
                                Grid.Column="1"
                                Style="{StaticResource GlassSortFilterButton}"
                                ToolTip="Sort and filter"
                                Click="SortFilterButton_Click">
                            <TextBlock Text="&#xE8CB;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Primary}"
                                       Effect="{StaticResource Text.Shadow}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="12,0,12,8"
                                  Height="36"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsDockerSurfaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                            <Button x:Name="LocalPaneTabButton"
                                    Style="{StaticResource GlassPaneTabLocal}"
                                    Command="{Binding SelectPaneCommand}"
                                    CommandParameter="{x:Static models:PortPane.Local}"
                                    Click="PaneTab_Click"/>
                            <Button x:Name="DockerPaneTabButton"
                                    Style="{StaticResource GlassPaneTabDocker}"
                                    Command="{Binding SelectPaneCommand}"
                                    CommandParameter="{x:Static models:PortPane.Docker}"
                                    Click="PaneTab_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ListHostGrid"
                          Grid.Row="2"
                          ClipToBounds="True"
                          MinHeight="120"
                          Margin="{StaticResource Glass.Align.ListGutter}"
                          VerticalAlignment="Stretch">
                        <ListBox x:Name="LocalPortsList"
                                 Panel.ZIndex="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding FilteredLocalPorts}"
                                 ItemContainerStyle="{StaticResource GlassPortListItemLocal}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="PortsList_PreviewMouseWheel"
                                 VerticalAlignment="Stretch"
                                 Padding="0,0,0,8">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PortInfo}">
                                    <controls:LocalPortRowControl KillCommand="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="DockerPortsList"
                                 Panel.ZIndex="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding FilteredDockerPorts}"
                                 ItemContainerStyle="{StaticResource GlassPortListItemDocker}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="PortsList_PreviewMouseWheel"
                                 VerticalAlignment="Stretch"
                                 Padding="0,0,0,8">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DockerPortInfo}">
                                    <controls:DockerPortRowControl KillCommand="{Binding DataContext.KillContainerCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="LocalEmptyStateText"
                                   Text="No local ports listening"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Effect="{StaticResource Text.Shadow}"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Local}"/>
                                                <Condition Binding="{Binding FilteredLocalPorts.Count}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="DockerEmptyStateText"
                                   Text="No published Docker TCP ports"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Effect="{StaticResource Text.Shadow}"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}"/>
                                                <Condition Binding="{Binding FilteredDockerPorts.Count}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="{StaticResource Glass.Align.FooterGutter}">
                        <Button Click="KillAll_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GlassFooterButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:PopupActionRow IconText="&#xE74D;"
                                                     LabelText="Kill All"
                                                     ShortcutText="Ctrl+K"
                                                     IconForeground="{StaticResource Danger}"
                                                     LabelForeground="{StaticResource Danger}"/>
                        </Button>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource GlassFooterDivider}">
                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Padding="{StaticResource Glass.Metrics.FooterChromePadding}">
                            <StackPanel>
                                <Button x:Name="RefreshButton"
                                        Click="RefreshButton_Click"
                                        Style="{StaticResource GlassFooterButton}">
                                    <controls:PopupActionRow x:Name="RefreshActionRow"
                                                             IconText="&#xE72C;"
                                                             LabelText="Refresh"
                                                             ShortcutText="Ctrl+R"/>
                                </Button>
                                <Button Click="HideToTray_Click"
                                        Style="{StaticResource GlassFooterButton}"
                                        ToolTip="Hide menu. PortCheck keeps running in the system tray">
                                    <controls:PopupActionRow IconText="&#xE738;"
                                                             LabelText="Hide"
                                                             ShortcutText="Esc"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
