<Window x:Class="PortCheck.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PortCheck.Models"
        xmlns:controls="clr-namespace:PortCheck.Controls"
        Title="PortCheck"
        Width="340"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="SettingsFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassFooterButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{StaticResource Glass.Metrics.FooterContentPadding}"
                                CornerRadius="{StaticResource Glass.Metrics.FooterHoverRadius}"
                                MinHeight="{StaticResource Glass.Metrics.RowMinHeight}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding PopupSurface}" Value="{x:Static models:PopupSurface.Settings}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PaneTab.Active.Fill}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsInlineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="52"/>
        </Style>

    </Window.Resources>

    <Border x:Name="OuterChromeBorder"
            CornerRadius="{StaticResource Glass.Metrics.WindowCornerRadius}"
            ClipToBounds="True"
            Effect="{StaticResource Glass.WindowShadow}">
        <Grid>
            <controls:GlassPopupShell x:Name="MainGlassShell"
                                      ShellCornerRadius="{StaticResource Glass.Metrics.WindowCornerRadius}"
                                      UseMenuChrome="False"/>
            <Border x:Name="InnerChromeBorder"
                    CornerRadius="{StaticResource Glass.Metrics.WindowInnerCornerRadius}"
                    Margin="2"
                    Background="Transparent">
                <Grid x:Name="InnerContentRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="{StaticResource Glass.Align.ChromeGutter}"
                          Height="{StaticResource Glass.Metrics.ChromeRowHeight}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PopupSurface}" Value="{x:Static models:PopupSurface.Settings}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Search.Fill}"
                                CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"
                                BorderBrush="{StaticResource Search.Stroke}"
                                BorderThickness="1"
                                Height="{StaticResource Glass.Metrics.ChromeRowHeight}"
                                Margin="0,0,8,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           FontFamily="Segoe Fluent Icons"
                                           Style="{StaticResource GlassTextSecondaryShadow}"
                                           Margin="10,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="12"/>
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource Text.Primary}"
                                         CaretBrush="{StaticResource Text.Primary}"
                                         VerticalContentAlignment="Center"
                                         FontSize="12"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Grid.Column="1"
                                           Text="Search local ports"
                                           IsHitTestVisible="False"
                                           Foreground="{StaticResource Text.Secondary}"
                                           Effect="{StaticResource Text.Shadow}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,10,0"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Button x:Name="SortFilterButton"
                                Grid.Column="1"
                                Style="{StaticResource GlassSortFilterButton}"
                                ToolTip="Sort and filter"
                                Click="SortFilterButton_Click">
                            <TextBlock Text="&#xE8CB;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Primary}"
                                       Effect="{StaticResource Text.Shadow}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="0"
                          Margin="{StaticResource Glass.Align.ChromeGutter}"
                          Height="{StaticResource Glass.Metrics.ChromeRowHeight}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PopupSurface}" Value="{x:Static models:PopupSurface.Settings}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton"
                                Width="{StaticResource Glass.Metrics.ChromeRowHeight}"
                                Height="{StaticResource Glass.Metrics.ChromeRowHeight}"
                                Margin="0,0,8,0"
                                Command="{Binding CloseSettingsCommand}"
                                Style="{StaticResource GlassChromeIconButton}">
                            <TextBlock Text="&#xE72B;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Primary}"
                                       Effect="{StaticResource Text.Shadow}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Settings"
                                       Style="{StaticResource GlassTextPrimaryShadow}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="2"
                                Width="{StaticResource Glass.Metrics.ChromeRowHeight}"
                                Margin="8,0,0,0"
                                Background="Transparent"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="12,0,12,8"
                                  Height="36"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PopupSurface}" Value="{x:Static models:PopupSurface.Settings}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDockerSurfaceVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                            <Button x:Name="LocalPaneTabButton"
                                    Style="{StaticResource GlassPaneTabLocal}"
                                    Command="{Binding SelectPaneCommand}"
                                    CommandParameter="{x:Static models:PortPane.Local}"
                                    Click="PaneTab_Click"/>
                            <Button x:Name="DockerPaneTabButton"
                                    Style="{StaticResource GlassPaneTabDocker}"
                                    Command="{Binding SelectPaneCommand}"
                                    CommandParameter="{x:Static models:PortPane.Docker}"
                                    Click="PaneTab_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ListHostGrid"
                          Grid.Row="2"
                          ClipToBounds="True"
                          MinHeight="120"
                          Margin="{StaticResource Glass.Align.ListGutter}"
                          VerticalAlignment="Stretch">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PopupSurface}" Value="{x:Static models:PopupSurface.Settings}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ListBox x:Name="LocalPortsList"
                                 Panel.ZIndex="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding FilteredLocalPorts}"
                                 ItemContainerStyle="{StaticResource GlassPortListItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="PortsList_PreviewMouseWheel"
                                 VerticalAlignment="Stretch"
                                 Padding="0,0,0,8">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PortInfo}">
                                    <controls:LocalPortRowControl KillCommand="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="DockerPortsList"
                                 Panel.ZIndex="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding FilteredDockerPorts}"
                                 ItemContainerStyle="{StaticResource GlassPortListItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="PortsList_PreviewMouseWheel"
                                 VerticalAlignment="Stretch"
                                 Padding="0,0,0,8">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DockerPortInfo}">
                                    <controls:DockerPortRowControl KillCommand="{Binding DataContext.KillContainerCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="No local ports listening"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Effect="{StaticResource Text.Shadow}"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Local}"/>
                                                <Condition Binding="{Binding FilteredLocalPorts.Count}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="No published Docker TCP ports"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Effect="{StaticResource Text.Shadow}"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}"/>
                                                <Condition Binding="{Binding FilteredDockerPorts.Count}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  Margin="12,0,12,8"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PopupSurface}" Value="{x:Static models:PopupSurface.Settings}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="0,0,0,10">
                            <Border Style="{StaticResource GlassSectionCardBorder}">
                                <StackPanel>
                                    <Grid Margin="8,4,8,4"
                                          MinHeight="{StaticResource Glass.Metrics.ChromeRowHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22"
                                                Height="22"
                                                CornerRadius="7"
                                                Background="{StaticResource Settings.BlueIconFill}"
                                                BorderBrush="#52FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8B7;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="Filter Ports"
                                                   Style="{StaticResource GlassTextPrimaryShadow}"
                                                   FontSize="12"
                                                   Margin="8,0,10,0"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="2"
                                                Background="{StaticResource Search.Fill}"
                                                CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"
                                                BorderBrush="{StaticResource Search.Stroke}"
                                                BorderThickness="1"
                                                Height="{StaticResource Glass.Metrics.ChromeRowHeight}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBox x:Name="ExcludedPortTextBox"
                                                     Margin="10,0"
                                                     Style="{StaticResource SettingsInlineTextBoxStyle}"
                                                     Text="{Binding ExcludedPortInput, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="ExcludedPortInput_KeyDown"/>
                                        </Border>
                                        <Button Grid.Column="3"
                                                Command="{Binding AddExcludedPortCommand}"
                                                Style="{StaticResource GlassCapsuleActionButtonRounded}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Add"
                                                       Style="{StaticResource GlassTextPrimaryShadow}"
                                                       FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <Border Style="{StaticResource GlassSectionDivider}"/>

                                    <ListBox ItemsSource="{Binding UserExcludedPorts}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource GlassEmbeddedPortListItem}"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="False"
                                             Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <controls:ExcludedPortRowControl Port="{Binding}"
                                                                                 RemoveCommand="{Binding DataContext.RemoveExcludedPortCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ExcludedPortValidationMessage}"
                                       Margin="10,0,0,18"
                                       Foreground="{StaticResource Danger}"
                                       Effect="{StaticResource Text.Shadow}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasExcludedPortValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border Style="{StaticResource GlassSectionCardBorder}">
                                <StackPanel>
                                    <Grid Margin="8,4,8,4"
                                          MinHeight="{StaticResource Glass.Metrics.RowMinHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22"
                                                Height="22"
                                                CornerRadius="7"
                                                Background="{StaticResource Settings.GreenIconFill}"
                                                BorderBrush="#52FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE823;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="Scan Interval"
                                                   Style="{StaticResource GlassTextPrimaryShadow}"
                                                   FontSize="12"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="RefreshIntervalTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource SettingsInlineTextBoxStyle}"
                                                     Text="{Binding RefreshIntervalInput, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="RefreshIntervalInput_KeyDown"
                                                     LostFocus="RefreshIntervalInput_LostFocus"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="sec"
                                                       Style="{StaticResource GlassTextTertiaryShadow}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding RefreshIntervalValidationMessage}"
                                       Margin="10,0,0,10"
                                       Foreground="{StaticResource Danger}"
                                       Effect="{StaticResource Text.Shadow}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasRefreshIntervalValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="{Binding SettingsStatusMessage}"
                                       Margin="10,0,0,0"
                                       Foreground="{StaticResource Danger}"
                                       Effect="{StaticResource Text.Shadow}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasSettingsStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Margin="{StaticResource Glass.Align.FooterGutter}">
                        <Button Click="KillAll_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GlassFooterButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PopupSurface}" Value="{x:Static models:PopupSurface.Settings}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:PopupActionRow IconText="&#xE74D;"
                                                     LabelText="Kill All"
                                                     ShortcutText="Ctrl+K"
                                                     IconForeground="{StaticResource Danger}"
                                                     LabelForeground="{StaticResource Danger}"/>
                        </Button>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource GlassFooterDivider}">
                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PopupSurface}" Value="{x:Static models:PopupSurface.Settings}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Padding="{StaticResource Glass.Metrics.FooterChromePadding}">
                            <StackPanel>
                                <Button x:Name="RefreshButton"
                                        Click="RefreshButton_Click"
                                        Style="{StaticResource GlassFooterButton}">
                                    <controls:PopupActionRow x:Name="RefreshActionRow"
                                                             IconText="&#xE72C;"
                                                             LabelText="Refresh"
                                                             ShortcutText="Ctrl+R"/>
                                </Button>
                                <Button x:Name="SettingsButton"
                                        Command="{Binding OpenSettingsCommand}"
                                        Style="{StaticResource SettingsFooterButtonStyle}">
                                    <controls:PopupActionRow IconText="&#xE713;"
                                                             LabelText="Settings"
                                                             ShortcutText="{Binding SettingsShortcutText}"/>
                                </Button>
                                <Button Click="HideToTray_Click"
                                        Style="{StaticResource GlassFooterButton}"
                                        ToolTip="Hide menu. PortCheck keeps running in the system tray">
                                    <controls:PopupActionRow IconText="&#xE738;"
                                                             LabelText="Hide"
                                                             ShortcutText="{Binding HideShortcutText}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
