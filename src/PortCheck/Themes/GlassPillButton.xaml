<!-- GlassPillButton: capsule chrome (Add, etc.). Motion: GlassChromeInteractionAnimator. -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

                    xmlns:controls="clr-namespace:PortCheck.Controls">

    <Style TargetType="{x:Type controls:GlassPillButton}">

        <Setter Property="MinWidth" Value="68"/>

        <Setter Property="Height" Value="{StaticResource Glass.Metrics.ChromeRowHeight}"/>

        <Setter Property="Padding" Value="16,0"/>

        <Setter Property="FontSize" Value="12"/>

        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>

        <Setter Property="Background" Value="{StaticResource GlassChrome.Idle.Fill}"/>

        <Setter Property="BorderBrush" Value="{StaticResource GlassChrome.Idle.Stroke}"/>

        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:GlassPillButton}">

                    <Grid x:Name="PART_Outer"

                          RenderTransformOrigin="0.5,0.5"

                          SnapsToDevicePixels="True"

                          UseLayoutRounding="True"

                          ClipToBounds="False">

                        <Grid.RenderTransform>

                            <ScaleTransform x:Name="PART_Scale" ScaleX="1" ScaleY="1"/>

                        </Grid.RenderTransform>

                        <Grid x:Name="PART_Root"

                              RenderTransformOrigin="0.5,0.5"

                              SnapsToDevicePixels="True"

                              UseLayoutRounding="True"

                              ClipToBounds="False">

                            <Grid.RenderTransform>

                                <TranslateTransform x:Name="PART_GelFollow" X="0" Y="0"/>

                            </Grid.RenderTransform>

                            <Border x:Name="PART_HitTarget"

                                    Background="Transparent"

                                    CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                    SnapsToDevicePixels="True"/>

                            <Grid x:Name="PART_GlassStack"

                                  RenderTransformOrigin="0.5,0.5"

                                  ClipToBounds="True"

                                  IsHitTestVisible="False"

                                  SnapsToDevicePixels="True">

                                <Grid.RenderTransform>

                                    <ScaleTransform x:Name="PART_InnerPinch" ScaleX="1" ScaleY="1"/>

                                </Grid.RenderTransform>

                                <Border x:Name="PART_ShadowHost"

                                        CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                        Background="Transparent"

                                        BorderThickness="0"

                                        IsHitTestVisible="False"

                                        SnapsToDevicePixels="True"/>

                                <Border x:Name="PART_LensPlate"

                                        CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                        ClipToBounds="True"

                                        BorderThickness="0"

                                        Opacity="0"

                                        IsHitTestVisible="False"

                                        SnapsToDevicePixels="True"/>

                                <Border x:Name="PART_Bd"

                                        Background="{TemplateBinding Background}"

                                        BorderBrush="{TemplateBinding BorderBrush}"

                                        BorderThickness="{TemplateBinding BorderThickness}"

                                        CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                        Opacity="0.88"

                                        IsHitTestVisible="False"

                                        SnapsToDevicePixels="True"/>

                                <Border x:Name="PART_FresnelRim"

                                        CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                        Background="Transparent"

                                        BorderThickness="1.25"

                                        Opacity="0"

                                        IsHitTestVisible="False"

                                        SnapsToDevicePixels="True">

                                    <Border.BorderBrush>

                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                            <GradientStop Color="#E6FFFFFF" Offset="0"/>

                                            <GradientStop Color="#55FFFFFF" Offset="0.35"/>

                                            <GradientStop Color="#18FFFFFF" Offset="0.65"/>

                                            <GradientStop Color="#AAFFFFFF" Offset="1"/>

                                        </LinearGradientBrush>

                                    </Border.BorderBrush>

                                </Border>

                                <Border x:Name="PART_RimHighlight"

                                        CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                        IsHitTestVisible="False"

                                        Opacity="0"

                                        SnapsToDevicePixels="True">

                                    <Border.Background>

                                        <RadialGradientBrush Center="0.35,0.22" GradientOrigin="0.35,0.22" RadiusX="0.9" RadiusY="0.9">

                                            <GradientStop Color="#55FFFFFF" Offset="0"/>

                                            <GradientStop Color="#00FFFFFF" Offset="0.55"/>

                                        </RadialGradientBrush>

                                    </Border.Background>

                                </Border>

                                <Border x:Name="PART_TopSpecular"

                                        CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                        VerticalAlignment="Top"

                                        Height="14"

                                        Margin="6,1,6,0"

                                        Opacity="0"

                                        IsHitTestVisible="False"

                                        SnapsToDevicePixels="True">

                                    <Border.Background>

                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                                            <GradientStop Color="#AAFFFFFF" Offset="0"/>

                                            <GradientStop Color="#33FFFFFF" Offset="0.45"/>

                                            <GradientStop Color="#00FFFFFF" Offset="1"/>

                                        </LinearGradientBrush>

                                    </Border.Background>

                                </Border>

                                <Border x:Name="PART_BottomSpecular"

                                        CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                        VerticalAlignment="Bottom"

                                        Height="9"

                                        Margin="8,0,8,2"

                                        Opacity="0"

                                        IsHitTestVisible="False"

                                        SnapsToDevicePixels="True">

                                    <Border.Background>

                                        <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">

                                            <GradientStop Color="#55FFFFFF" Offset="0"/>

                                            <GradientStop Color="#00FFFFFF" Offset="1"/>

                                        </LinearGradientBrush>

                                    </Border.Background>

                                </Border>

                                <Border x:Name="PART_PressGlow"

                                        CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"

                                        IsHitTestVisible="False"

                                        Opacity="0"

                                        SnapsToDevicePixels="True"/>

                            </Grid>

                            <ContentPresenter x:Name="PART_Icon"

                                              IsHitTestVisible="False"

                                              HorizontalAlignment="Center"

                                              VerticalAlignment="Center"

                                              Margin="{TemplateBinding Padding}"

                                              RecognizesAccessKey="True"

                                              SnapsToDevicePixels="True"

                                              TextOptions.TextRenderingMode="ClearType"

                                              TextOptions.TextFormattingMode="Display"/>

                        </Grid>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsEnabled" Value="False">

                            <Setter Property="Opacity" Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>

