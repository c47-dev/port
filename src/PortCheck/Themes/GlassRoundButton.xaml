<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PortCheck.Controls">
    <SolidColorBrush x:Key="GlassRound.Idle.Fill" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="GlassRound.Idle.Stroke" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="GlassRound.Hover.Stroke" Color="#A0FFFFFF"/>

    <Style TargetType="{x:Type controls:GlassRoundButton}">
        <Setter Property="Width" Value="{StaticResource Glass.Metrics.ChromeRowHeight}"/>
        <Setter Property="Height" Value="{StaticResource Glass.Metrics.ChromeRowHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource GlassRound.Idle.Fill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassRound.Idle.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:GlassRoundButton}">
                    <Grid x:Name="PART_Root"
                          RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PART_Scale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="PART_GelFollow" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <!-- Full 32×32 hit target; decorative layers stay non-hit-testable. -->
                        <Border x:Name="PART_HitTarget"
                                Background="Transparent"
                                CornerRadius="999"
                                SnapsToDevicePixels="True"/>
                        <!-- Glass material only — DropShadow on PART_ShadowHost, never on this grid (would blur icon). -->
                        <Border x:Name="PART_ShadowHost"
                                CornerRadius="999"
                                Background="Transparent"
                                BorderThickness="0"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="PART_Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999"
                                Opacity="0.88"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="PART_CollapseVignette"
                                CornerRadius="999"
                                IsHitTestVisible="False"
                                Opacity="0"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="PART_RimHighlight"
                                CornerRadius="999"
                                IsHitTestVisible="False"
                                Opacity="0"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.22,0.05" EndPoint="0.58,0.95">
                                    <GradientStop Color="#62FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="PART_PressGlow"
                                CornerRadius="999"
                                IsHitTestVisible="False"
                                Opacity="0"
                                SnapsToDevicePixels="True"/>
                        <!-- Icon above all glass layers — no bitmap effect on ancestors. -->
                        <ContentPresenter x:Name="PART_Icon"
                                          IsHitTestVisible="False"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"
                                          TextOptions.TextRenderingMode="ClearType"
                                          TextOptions.TextFormattingMode="Display"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
