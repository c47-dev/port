<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:PortCheck.Models"
                    xmlns:helpers="clr-namespace:PortCheck.Helpers">

    <!-- Visual glass stack (works on top of captured blur OR fallback) -->
    <SolidColorBrush x:Key="Glass.Tint" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="Glass.TintEdge" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Glass.Overlay" Color="#42000000"/>
    <SolidColorBrush x:Key="Glass.Stroke" Color="#45FFFFFF"/>
    <SolidColorBrush x:Key="Glass.StrokeBright" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Accent.Blue" Color="#5B9DD9"/>
    <SolidColorBrush x:Key="Status.Active" Color="#34C759"/>
    <SolidColorBrush x:Key="Danger" Color="#FF453A"/>
    <SolidColorBrush x:Key="Hover.Surface" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Search.Fill" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Search.Stroke" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Idle.Fill" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Active.Fill" Color="#72FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Active.Stroke" Color="#A0FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Docker.Accent" Color="#FF1D63ED"/>
    <SolidColorBrush x:Key="PaneTab.Local.RowHover.Fill" Color="#34FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Local.RowHover.Stroke" Color="#82FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Docker.RowHover.Fill" Color="#261D63ED"/>
    <SolidColorBrush x:Key="PaneTab.Docker.RowHover.Stroke" Color="#6F74B0FF"/>
    <SolidColorBrush x:Key="Glass.Action.Ghost.Fill" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Glass.Action.Ghost.HoverFill" Color="#48FFFFFF"/>
    <SolidColorBrush x:Key="Glass.Action.Ghost.Stroke" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Glass.Action.Danger.Fill" Color="#28FF453A"/>
    <SolidColorBrush x:Key="Glass.Action.Danger.HoverFill" Color="#52FF453A"/>
    <SolidColorBrush x:Key="Glass.Action.Danger.Stroke" Color="#8FFF8A84"/>

    <!-- Alignment grid: columns line up; each surface keeps its own radius / padding / height. -->
    <system:Double x:Key="Glass.Align.ContentInset" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <Thickness x:Key="Glass.Align.HorizontalGutter">12,0,12,0</Thickness>
    <Thickness x:Key="Glass.Align.ListGutter">12,0,12,0</Thickness>
    <GridLength x:Key="Glass.Align.IconColumn">20</GridLength>
    <GridLength x:Key="Glass.Align.PortColumn">56</GridLength>
    <GridLength x:Key="Glass.Align.ShortcutColumn">44</GridLength>
    <system:Double x:Key="Glass.Align.IconWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <system:Double x:Key="Glass.Align.ShortcutWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">44</system:Double>

    <system:Double x:Key="Glass.Metrics.TabHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>
    <GridLength x:Key="Glass.Metrics.TabIconSlot">32</GridLength>
    <system:Double x:Key="Glass.Metrics.TabIconSlotWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>
    <CornerRadius x:Key="Glass.Metrics.TabCornerRadius">16</CornerRadius>
    <Thickness x:Key="Glass.Metrics.TabLabelTrailing">0,0,8,0</Thickness>

    <Thickness x:Key="Glass.Metrics.ListItemPadding">6,2</Thickness>
    <CornerRadius x:Key="Glass.Metrics.ListHoverRadius">8</CornerRadius>
    <system:Double x:Key="Glass.Metrics.RowMinHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">26</system:Double>
    <system:Double x:Key="Glass.Metrics.RowLeading" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>

    <Thickness x:Key="Glass.Metrics.FooterContentPadding">6,2</Thickness>
    <Thickness x:Key="Glass.Metrics.FooterRowSpacing">0</Thickness>
    <CornerRadius x:Key="Glass.Metrics.FooterHoverRadius">8</CornerRadius>
    <CornerRadius x:Key="Glass.Metrics.FooterLastHoverRadius">8,8,14,14</CornerRadius>
    <Thickness x:Key="Glass.Metrics.FooterSeparatorMargin">0,4,0,4</Thickness>

    <system:Double x:Key="Glass.Metrics.DockerMarkWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="Glass.Metrics.DockerMarkHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="Glass.Metrics.KillButton" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <CornerRadius x:Key="Glass.Metrics.KillCornerRadius">10</CornerRadius>

    <!-- Soft rim: weaker top-left highlight (top was too harsh vs bottom) -->
    <LinearGradientBrush x:Key="Glass.RimLight" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#50FFFFFF" Offset="0"/>
        <GradientStop Color="#38FFFFFF" Offset="0.5"/>
        <GradientStop Color="#42FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Glass.InnerSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#10FFFFFF" Offset="0"/>
        <GradientStop Color="#06FFFFFF" Offset="0.2"/>
        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Glass.WindowShadow"
                      Color="#55000000" Opacity="0.32" BlurRadius="36" ShadowDepth="10"/>
    <DropShadowEffect x:Key="Text.Shadow"
                      Color="#90000000"
                      Opacity="0.72"
                      BlurRadius="3"
                      ShadowDepth="1"
                      Direction="270"/>

    <Style x:Key="GlassScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="MinWidth" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="{TemplateBinding Width}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBd" Background="#55FFFFFF"
                                                    CornerRadius="4" Margin="0,2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="#90FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="MinHeight" Value="4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassPillButton" TargetType="Button">
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="14" Padding="{TemplateBinding Padding}"
                            BorderBrush="#60FFFFFF" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#58FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPillButtonDanger" TargetType="Button" BasedOn="{StaticResource GlassPillButton}">
        <Setter Property="Background" Value="{StaticResource Danger}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassFooterIcon" TargetType="TextBlock">
        <Setter Property="Width" Value="{StaticResource Glass.Align.IconWidth}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassFooterLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassFooterShortcut" TargetType="TextBlock">
        <Setter Property="Width" Value="{StaticResource Glass.Align.ShortcutWidth}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassTextPrimaryShadow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassTextSecondaryShadow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassTextTertiaryShadow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassActionRowGrid" TargetType="Grid">
        <Setter Property="MinHeight" Value="{StaticResource Glass.Metrics.RowMinHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Footer + Docker rows: icon | label | shortcut (no port column). -->
    <Style x:Key="GlassCompactRowGrid" TargetType="Grid" BasedOn="{StaticResource GlassActionRowGrid}"/>

    <!-- Footer: compact row; hover radius matches list (6px), padding 6,2. -->
    <Style x:Key="GlassFooterButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="{StaticResource Glass.Metrics.FooterRowSpacing}"/>
        <Setter Property="MinHeight" Value="{StaticResource Glass.Metrics.RowMinHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            Padding="{StaticResource Glass.Metrics.FooterContentPadding}"
                            CornerRadius="{StaticResource Glass.Metrics.FooterHoverRadius}"
                            MinHeight="{StaticResource Glass.Metrics.RowMinHeight}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassFooterButtonLast" TargetType="Button" BasedOn="{StaticResource GlassFooterButton}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            Padding="{StaticResource Glass.Metrics.FooterContentPadding}"
                            CornerRadius="{StaticResource Glass.Metrics.FooterLastHoverRadius}"
                            MinHeight="{StaticResource Glass.Metrics.RowMinHeight}"
                            Margin="0,0,0,2">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassTrayMenuButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassRowKillButton" TargetType="Button">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Danger}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassRowDismissButton" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#35FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#50FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassRowKillButtonExtracted" TargetType="Button" BasedOn="{StaticResource GlassRowKillButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource Glass.Action.Danger.Fill}"
                            BorderBrush="{StaticResource Glass.Action.Danger.Stroke}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass.Action.Danger.HoverFill}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassRowKillIconButtonExtracted" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Glass.Metrics.KillButton}"/>
        <Setter Property="Height" Value="{StaticResource Glass.Metrics.KillButton}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource Danger}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource Glass.Action.Danger.Fill}"
                            BorderBrush="{StaticResource Glass.Action.Danger.Stroke}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Glass.Metrics.KillCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass.Action.Danger.HoverFill}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassRowDismissButtonExtracted" TargetType="Button" BasedOn="{StaticResource GlassRowDismissButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource Glass.Action.Ghost.Fill}"
                            BorderBrush="{StaticResource Glass.Action.Ghost.Stroke}"
                            BorderThickness="1"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass.Action.Ghost.HoverFill}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PaneTab.Active.Stroke}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS 18 Mail Smart Categories: idle circle → active frosted-glass pill -->
    <Style x:Key="GlassPaneTabBase" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Glass.Metrics.TabHeight}"/>
        <Setter Property="Width" Value="{StaticResource Glass.Metrics.TabIconSlotWidth}"/>
        <Setter Property="MinWidth" Value="{StaticResource Glass.Metrics.TabIconSlotWidth}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GlassPaneTabLocal" TargetType="Button" BasedOn="{StaticResource GlassPaneTabBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            CornerRadius="{StaticResource Glass.Metrics.TabCornerRadius}"
                            Height="{StaticResource Glass.Metrics.TabHeight}"
                            Width="{TemplateBinding Width}"
                            Background="{StaticResource PaneTab.Idle.Fill}"
                            BorderBrush="#45FFFFFF" BorderThickness="1"
                            SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Glass.Metrics.TabIconSlot}"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TabIcon" Grid.Column="0" Text="&#xE7F8;"
                                       FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Label" Grid.Column="1" Text="Local Port"
                                       Visibility="Collapsed" Opacity="0"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       Margin="{StaticResource Glass.Metrics.TabLabelTrailing}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Local}">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource PaneTab.Active.Fill}"/>
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource PaneTab.Active.Stroke}"/>
                            <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Label" Property="Opacity" Value="1"/>
                            <Setter TargetName="Label" Property="Margin" Value="4,0,8,0"/>
                            <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#40FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPaneTabDocker" TargetType="Button" BasedOn="{StaticResource GlassPaneTabBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            CornerRadius="{StaticResource Glass.Metrics.TabCornerRadius}"
                            Height="{StaticResource Glass.Metrics.TabHeight}"
                            Width="{TemplateBinding Width}"
                            Background="{StaticResource PaneTab.Idle.Fill}"
                            BorderBrush="#45FFFFFF" BorderThickness="1"
                            SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Glass.Metrics.TabIconSlot}"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0"
                                     Width="{StaticResource Glass.Metrics.DockerMarkWidth}"
                                     Height="{StaticResource Glass.Metrics.DockerMarkHeight}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                <Path Data="{x:Static helpers:DockerIconGeometry.Logo}"
                                      Fill="{StaticResource PaneTab.Docker.Accent}"/>
                            </Viewbox>
                            <TextBlock x:Name="Label" Grid.Column="1" Text="Docker Port"
                                       Visibility="Collapsed" Opacity="0"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       Margin="{StaticResource Glass.Metrics.TabLabelTrailing}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ActivePane}" Value="{x:Static models:PortPane.Docker}">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource PaneTab.Active.Fill}"/>
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource PaneTab.Active.Stroke}"/>
                            <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Label" Property="Opacity" Value="1"/>
                            <Setter TargetName="Label" Property="Margin" Value="4,0,8,0"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#40FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List row: full-bleed subtle lift; smaller radius than footer chips. -->
    <Style x:Key="GlassPortListItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{StaticResource Glass.Metrics.ListItemPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
        <Setter Property="MinHeight" Value="{StaticResource Glass.Metrics.RowMinHeight}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Glass.Metrics.ListHoverRadius}"
                            ClipToBounds="False">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

