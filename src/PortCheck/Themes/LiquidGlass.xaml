<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:PortCheck.Models"
                    xmlns:helpers="clr-namespace:PortCheck.Helpers">

    <!-- Visual glass stack (works on top of captured blur OR fallback) -->
    <SolidColorBrush x:Key="Glass.Tint" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="Glass.Stroke" Color="#45FFFFFF"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Accent.Blue" Color="#5B9DD9"/>
    <SolidColorBrush x:Key="Status.Active" Color="#34C759"/>
    <SolidColorBrush x:Key="Glass.Action.Danger.Foreground" Color="#FFFF8A84"/>
    <SolidColorBrush x:Key="Hover.Surface" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Search.Fill" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Search.Stroke" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Idle.Fill" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Active.Fill" Color="#72FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Active.Stroke" Color="#A0FFFFFF"/>
    <SolidColorBrush x:Key="PaneTab.Docker.Accent" Color="#FF1D63ED"/>
    <SolidColorBrush x:Key="Glass.Action.Ghost.Fill" Color="#32FFFFFF"/>
    <SolidColorBrush x:Key="Glass.Action.Ghost.HoverFill" Color="#58FFFFFF"/>
    <SolidColorBrush x:Key="Glass.Action.Ghost.Stroke" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Glass.Action.Danger.Fill" Color="#3CFF5C4F"/>
    <SolidColorBrush x:Key="Glass.Action.Danger.HoverFill" Color="#62FF6A5E"/>
    <SolidColorBrush x:Key="Glass.Action.Danger.Stroke" Color="#8FFF8A84"/>
    <SolidColorBrush x:Key="Glass.List.Surface.Fill" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Glass.List.Surface.Border" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Glass.List.Surface.Highlight" Color="#30FFFFFF"/>

    <LinearGradientBrush x:Key="Settings.BlueIconFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5AA8FF" Offset="0"/>
        <GradientStop Color="#FF2F6FC8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Settings.GreenIconFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF58D777" Offset="0"/>
        <GradientStop Color="#FF2E9E4B" Offset="1"/>
    </LinearGradientBrush>

    <!-- Alignment grid: columns line up; each surface keeps its own radius / padding / height. -->
    <system:Double x:Key="Glass.Align.ContentInset" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <Thickness x:Key="Glass.Align.HorizontalGutter">12,0,12,0</Thickness>
    <Thickness x:Key="Glass.Align.ListGutter">12,0,6,0</Thickness>
    <Thickness x:Key="Glass.Align.FooterGutter">12,0,12,0</Thickness>
    <Thickness x:Key="Glass.Align.ChromeGutter">12,12,12,10</Thickness>
    <GridLength x:Key="Glass.Align.IconColumn">20</GridLength>
    <GridLength x:Key="Glass.Align.PortColumn">56</GridLength>
    <GridLength x:Key="Glass.Align.ShortcutColumn">44</GridLength>
    <system:Double x:Key="Glass.Align.IconWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <system:Double x:Key="Glass.Align.ShortcutWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">44</system:Double>

    <system:Double x:Key="Glass.Metrics.ChromeRowHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>
    <CornerRadius x:Key="Glass.Metrics.ChromeCapsuleRadius">16</CornerRadius>
    <system:Double x:Key="Glass.Metrics.ChromeRowGap" xmlns:system="clr-namespace:System;assembly=mscorlib">8</system:Double>

    <system:Double x:Key="Glass.Metrics.TabHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>
    <GridLength x:Key="Glass.Metrics.TabIconSlot">32</GridLength>
    <system:Double x:Key="Glass.Metrics.TabIconSlotWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>
    <CornerRadius x:Key="Glass.Metrics.TabCornerRadius">16</CornerRadius>
    <Thickness x:Key="Glass.Metrics.TabLabelTrailing">0,0,8,0</Thickness>

    <Thickness x:Key="Glass.Metrics.ListItemPadding">6,2</Thickness>
    <CornerRadius x:Key="Glass.Metrics.ListHoverRadius">10</CornerRadius>
    <system:Double x:Key="Glass.Metrics.RowMinHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">26</system:Double>
    <system:Double x:Key="Glass.Metrics.RowLeading" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <Thickness x:Key="Glass.Metrics.ListSurfaceInset">0,0,0,1</Thickness>

    <Thickness x:Key="Glass.Metrics.FooterContentPadding">6,2</Thickness>
    <Thickness x:Key="Glass.Metrics.FooterChromePadding">0,8,0,8</Thickness>
    <CornerRadius x:Key="Glass.Metrics.FooterHoverRadius">8</CornerRadius>

    <CornerRadius x:Key="Glass.Metrics.WindowCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="Glass.Metrics.WindowInnerCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="Glass.Metrics.PopupMenuCornerRadius">12</CornerRadius>
    <Thickness x:Key="Glass.Metrics.PopupMenuPadding">4</Thickness>
    <CornerRadius x:Key="Glass.Metrics.PopupMenuItemCornerRadius">8</CornerRadius>
    <Thickness x:Key="Glass.Metrics.PopupMenuItemPadding">10,6</Thickness>

    <system:Double x:Key="Glass.Metrics.DockerMarkWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="Glass.Metrics.DockerMarkHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="Glass.Metrics.KillButton" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <CornerRadius x:Key="Glass.Metrics.KillCornerRadius">10</CornerRadius>
    <system:Double x:Key="Glass.Metrics.KillLabelHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">22</system:Double>
    <CornerRadius x:Key="Glass.Metrics.KillLabelCornerRadius">11</CornerRadius>
    <Geometry x:Key="Glass.Icon.DismissPath">M0,0 L8,8 M8,0 L0,8</Geometry>

    <!-- Soft rim: weaker top-left highlight (top was too harsh vs bottom) -->
    <LinearGradientBrush x:Key="Glass.RimLight" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#50FFFFFF" Offset="0"/>
        <GradientStop Color="#38FFFFFF" Offset="0.5"/>
        <GradientStop Color="#42FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Glass.InnerSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#10FFFFFF" Offset="0"/>
        <GradientStop Color="#06FFFFFF" Offset="0.2"/>
        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Glass.WindowShadow"
                      Color="#55000000" Opacity="0.32" BlurRadius="36" ShadowDepth="10"/>
    <DropShadowEffect x:Key="Text.Shadow"
                      Color="#90000000"
                      Opacity="0.72"
                      BlurRadius="3"
                      ShadowDepth="1"
                      Direction="270"/>

    <Style x:Key="GlassScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="MinWidth" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="{TemplateBinding Width}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBd" Background="#55FFFFFF"
                                                    CornerRadius="4" Margin="0,2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="#90FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="MinHeight" Value="4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Liquid chrome family: GlassChrome.xaml + GlassRoundButton / GlassPillButton (not styles below). -->

    <!-- Popup chrome: use Controls.GlassPopupShell (tint + sheen + rim + captured blur). -->
    <!-- Sort/filter popup: port-list low-light blur (single soft edge, no rim/sheen stack). -->
    <Style x:Key="GlassSortMenuShell" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Glass.List.Surface.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Glass.Metrics.PopupMenuCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource Glass.Metrics.PopupMenuPadding}"/>
        <Setter Property="MinWidth" Value="168"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Sort menu rows: same hover/selection as GlassPortListItem (Hover.Surface, no stroke). -->
    <Style x:Key="GlassSortMenuItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Padding="8,4"
                            CornerRadius="{StaticResource Glass.Metrics.ListHoverRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,4,8,4"/>
        <Setter Property="Opacity" Value="0.45"/>
        <Setter Property="Background" Value="{StaticResource Glass.Stroke}"/>
    </Style>

    <!-- Legacy static capsule; prefer Controls.GlassPillButton + Themes/GlassPillButton.xaml -->
    <Style x:Key="GlassCapsuleActionButton" TargetType="Button">
        <Setter Property="MinWidth" Value="68"/>
        <Setter Property="Height" Value="{StaticResource Glass.Metrics.ChromeRowHeight}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource PaneTab.Idle.Fill}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Glass.Metrics.ChromeCapsuleRadius}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#58FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PaneTab.Active.Stroke}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PaneTab.Active.Fill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSectionCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Glass.List.Surface.Fill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Glass.List.Surface.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Glass.Metrics.ListHoverRadius}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GlassSectionDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#18FFFFFF"/>
        <Setter Property="Margin" Value="8,0,8,0"/>
    </Style>

    <Style x:Key="GlassFooterIcon" TargetType="TextBlock">
        <Setter Property="Width" Value="{StaticResource Glass.Align.IconWidth}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassFooterLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassFooterShortcut" TargetType="TextBlock">
        <Setter Property="Width" Value="{StaticResource Glass.Align.ShortcutWidth}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassTextPrimaryShadow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassTextSecondaryShadow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassTextTertiaryShadow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
        <Setter Property="Effect" Value="{StaticResource Text.Shadow}"/>
    </Style>

    <Style x:Key="GlassActionRowGrid" TargetType="Grid">
        <Setter Property="MinHeight" Value="{StaticResource Glass.Metrics.RowMinHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Footer + Docker rows: icon | label | shortcut (no port column). -->
    <Style x:Key="GlassCompactRowGrid" TargetType="Grid" BasedOn="{StaticResource GlassActionRowGrid}"/>

    <!-- Footer: compact row; hover radius matches list (6px), padding 6,2. -->
    <Style x:Key="GlassFooterButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="{StaticResource Glass.Metrics.RowMinHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            Padding="{StaticResource Glass.Metrics.FooterContentPadding}"
                            CornerRadius="{StaticResource Glass.Metrics.FooterHoverRadius}"
                            MinHeight="{StaticResource Glass.Metrics.RowMinHeight}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassTrayMenuButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassRowKillButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Glass.Metrics.KillLabelHeight}"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFFDFDFD"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource Glass.Action.Danger.Fill}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Glass.Metrics.KillLabelCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass.Action.Danger.HoverFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassRowKillIconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Glass.Metrics.KillButton}"/>
        <Setter Property="Height" Value="{StaticResource Glass.Metrics.KillButton}"/>
        <Setter Property="Background" Value="{StaticResource Glass.Action.Danger.Fill}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="999"/>
                        <Path Data="{StaticResource Glass.Icon.DismissPath}"
                              Width="8"
                              Height="8"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="#FFFDFDFD"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass.Action.Danger.HoverFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassRowDismissButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Glass.Metrics.KillButton}"/>
        <Setter Property="Height" Value="{StaticResource Glass.Metrics.KillButton}"/>
        <Setter Property="Background" Value="{StaticResource Glass.Action.Ghost.Fill}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="999"/>
                        <Path Data="{StaticResource Glass.Icon.DismissPath}"
                              Width="8"
                              Height="8"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="#FFFDFDFD"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass.Action.Ghost.HoverFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pane tabs: Controls.GlassPaneTabButton + Themes/GlassPaneTabButton.xaml (hover-only chrome). -->

    <!-- List row: idle flat; hover/selected use Hover.Surface (Local + Docker panes). -->
    <Style x:Key="GlassPortListItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="MinHeight" Value="{StaticResource Glass.Metrics.RowMinHeight}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource Glass.Metrics.ListHoverRadius}"
                                ClipToBounds="True"
                                Margin="{StaticResource Glass.Metrics.ListSurfaceInset}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsConfirmingKill}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover.Surface}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassEmbeddedPortListItem" TargetType="ListBoxItem" BasedOn="{StaticResource GlassPortListItem}">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

</ResourceDictionary>
